# Auth.js / NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Optional; defaults to http://localhost:3000 in development
AUTH_URL=http://localhost:3000

# GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Wispr Flow org API key (https://wisprflow.ai/developers) — stays on the server
WISPR_API_KEY=

# Cursor API key is entered in the meeting setup UI and stored on the Auth.js session.
# Get a key at https://cursor.com/dashboard/integrations
# Ensure the Cursor GitHub App is connected to the repos you want to discuss.
